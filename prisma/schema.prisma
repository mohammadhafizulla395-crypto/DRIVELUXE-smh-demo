// DriveLuxe — Premium Car Rental Platform
// Prisma schema (SQLite). Lists stored as comma-separated strings.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id               String             @id @default(cuid())
  name             String
  email            String             @unique
  password         String
  phone            String?
  role             String             @default("user") // "user" | "admin"
  points           Int                @default(0)
  archived         Boolean            @default(false)
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  bookings         Booking[]
  reviews          Review[]
  supportTickets   SupportTicket[]
  pointTransactions PointTransaction[]
}

model Car {
  id           String   @id @default(cuid())
  name         String
  brand        String
  type         String // Sedan | SUV | Sports | Convertible | Electric
  transmission String   @default("Automatic") // Automatic | Manual
  fuel         String   @default("Petrol") // Petrol | Diesel | Electric | Hybrid
  seats        Int      @default(5)
  year         Int      @default(2024)
  pricePerDay  Float
  image        String
  features     String   @default("") // comma-separated
  description  String   @default("")
  available    Boolean  @default(true)
  featured     Boolean  @default(false)
  archived     Boolean  @default(false)
  rating       Float    @default(4.5)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  bookings     Booking[]
  reviews      Review[]
}

// Booking workflow: Booked → Paid → Pickup → In Use → Returned → Completed
// (cancelled can happen from booked/paid)
model Booking {
  id             String   @id @default(cuid())
  userId         String
  carId          String
  startDate      DateTime
  endDate        DateTime
  totalDays      Int
  totalPrice     Float
  pickupLocation String   @default("Downtown Office")
  // booked | paid | pickup | in_use | returned | completed | cancelled
  status         String   @default("booked")
  archived       Boolean  @default(false)
  createdAt      DateTime @default(now())
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  car            Car      @relation(fields: [carId], references: [id], onDelete: Cascade)
  payment        Payment?

  @@index([carId, startDate, endDate])
  @@index([userId])
  @@index([status])
}

model Review {
  id        String   @id @default(cuid())
  userId    String
  carId     String
  rating    Int // 1-5
  comment   String   @default("")
  archived  Boolean  @default(false)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  car       Car      @relation(fields: [carId], references: [id], onDelete: Cascade)

  @@unique([userId, carId])
  @@index([carId])
}

// Support / Complaints workflow: Open → In Progress → Resolved → Closed
model SupportTicket {
  id        String   @id @default(cuid())
  userId    String
  subject   String
  category  String   @default("general") // general | booking | refund | payment | other
  message   String
  // open | in_progress | resolved | closed
  status    String   @default("open")
  archived  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
}

model PointTransaction {
  id        String   @id @default(cuid())
  userId    String
  amount    Int // positive = earned, negative = redeemed
  reason    String
  bookingId String?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// Payment workflow: Pending → Paid → Refunded
model Payment {
  id          String   @id @default(cuid())
  bookingId   String   @unique
  userId      String
  amount      Float
  method      String   @default("card") // card | cash | transfer
  // pending | paid | refunded
  status      String   @default("pending")
  txnRef      String?  // transaction reference
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  booking     Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
}

// Activity log — powers the admin "Recent activity" feed
model Activity {
  id        String   @id @default(cuid())
  type      String // booking_created | booking_status | payment | complaint | review | car | user
  message   String
  actorId   String?  // admin/user who performed the action
  refId     String?  // related entity id
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([type])
}
