// DriveLuxe — Premium Car Rental Platform
// Prisma schema (SQLite). Lists stored as comma-separated strings.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id               String             @id @default(cuid())
  name             String
  email            String             @unique
  password         String
  phone            String?
  role             String             @default("user") // "user" | "admin"
  points           Int                @default(0)
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  bookings         Booking[]
  reviews          Review[]
  supportTickets   SupportTicket[]
  pointTransactions PointTransaction[]
}

model Car {
  id           String   @id @default(cuid())
  name         String
  brand        String
  type         String // Sedan | SUV | Sports | Convertible | Electric
  transmission String   @default("Automatic") // Automatic | Manual
  fuel         String   @default("Petrol") // Petrol | Diesel | Electric | Hybrid
  seats        Int      @default(5)
  year         Int      @default(2024)
  pricePerDay  Float
  image        String
  features     String   @default("") // comma-separated
  description  String   @default("")
  available    Boolean  @default(true)
  featured     Boolean  @default(false)
  rating       Float    @default(4.5)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  bookings     Booking[]
  reviews      Review[]
}

model Booking {
  id             String   @id @default(cuid())
  userId         String
  carId          String
  startDate      DateTime
  endDate        DateTime
  totalDays      Int
  totalPrice     Float
  pickupLocation String   @default("Downtown Office")
  status         String   @default("confirmed") // pending | confirmed | completed | cancelled
  createdAt      DateTime @default(now())
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  car            Car      @relation(fields: [carId], references: [id], onDelete: Cascade)

  @@index([carId, startDate, endDate])
  @@index([userId])
}

model Review {
  id        String   @id @default(cuid())
  userId    String
  carId     String
  rating    Int // 1-5
  comment   String   @default("")
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  car       Car      @relation(fields: [carId], references: [id], onDelete: Cascade)

  @@unique([userId, carId]) // one review per user per car
  @@index([carId])
}

model SupportTicket {
  id        String   @id @default(cuid())
  userId    String
  subject   String
  category  String   @default("general") // general | booking | refund | payment | other
  message   String
  status    String   @default("open") // open | in_progress | resolved | closed
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model PointTransaction {
  id        String   @id @default(cuid())
  userId    String
  amount    Int // positive = earned, negative = redeemed
  reason    String
  bookingId String?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}
