# DriveLuxe — Environment Variables
# Copy this file to .env and fill in your values.
# Never commit .env to version control.

# Database - local SQLite file (created at prisma/dev.db by `bunx prisma db push`).
# Fully offline: no DB server, no network, nothing to disconnect.
DATABASE_URL=file:./dev.db

# The old Supabase project is gone (its ref no longer resolves in DNS), so these
# are intentionally left empty. Original values live in .env.supabase.bak.
# To use Postgres again: restore that file, flip the provider in
# prisma/schema.prisma back to "postgresql", re-add `directUrl`, then
# `bunx prisma migrate deploy` and re-seed.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Application Authentication
JWT_SECRET=

# Razorpay Test Mode
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
NEXT_PUBLIC_RAZORPAY_KEY_ID=
